# Salesforce Connected App consumer key. This value is safe to expose to the browser.
VITE_SF_CLIENT_ID=

# Use https://test.salesforce.com for a sandbox.
VITE_SF_LOGIN_URL=https://login.salesforce.com

# Must be HTTPS and exactly match a Connected App callback URL.
VITE_SF_REDIRECT_URI=https://rescue.example.com/oauth/callback

# Google Maps JavaScript API browser key. Restrict it by HTTP referrer and API.
VITE_GOOGLE_MAPS_API_KEY=